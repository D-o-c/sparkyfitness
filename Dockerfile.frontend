# Stage 1: Build the React application
FROM node:20-slim AS builder
WORKDIR /app/SparkyFitnessFrontend

# Copy package files and install dependencies
COPY SparkyFitnessFrontend/package.json SparkyFitnessFrontend/package-lock.json ./
RUN npm install

# Copy the rest of the application source code
COPY SparkyFitnessFrontend .

# Build the application
RUN npm run build

# Stage 2: Serve the application with Nginx
FROM nginxinc/nginx-unprivileged:alpine-slim

# Temporarily switch to root to install curl for the healthcheck, then drop privileges again.
USER root
RUN apk add --no-cache curl
USER 101

# Copy the build output from the builder stage
COPY --from=builder /app/SparkyFitnessFrontend/dist/ /usr/share/nginx/html/

# Copy the nginx configuration template adjusted for unprivileged nginx
COPY SparkyFitnessFrontend/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 8080 to match the unprivileged nginx default
EXPOSE 8080

# Healthcheck
HEALTHCHECK --interval=5s --timeout=10s --retries=5 CMD ["curl", "http://127.0.0.1:8080"]

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
